# 示例仅引用环境变量，不含明文 secret/token。真实配置复制为 env.yml，禁止入库。
name: "example-service" # HMAC 目标服务名称，必填，调用方签名使用同一值，1–64 位安全标识。
shutdown_timeout: "20s" # 全局排空预算，缺省20s，必须>0且小于systemd TimeoutStopSec=30s。
http: # 整段缺失即关闭HTTP；至少启用HTTP/gRPC之一。
  addr: "127.0.0.1:8080" # HTTP监听地址，空值同此；非loopback须同时配置cert_file/key_file。
  cert_file: "" # TLS证书路径，与key_file成对；仅loopback可同时留空。
  key_file: "" # TLS私钥路径，与cert_file成对，私钥文件不入库。
  read_header_timeout: "5s" # 读请求头上限，0/缺省=5s，必须为正。
  read_timeout: "10s" # 读取完整请求上限，0/缺省=10s，必须为正。
  write_timeout: "15s" # 响应写入上限，0/缺省=15s，须>=request_timeout。
  idle_timeout: "60s" # keep-alive空闲期限，0/缺省=60s，必须为正。
  request_timeout: "3s" # 请求处理上下文预算，0/缺省=3s，handler须遵守ctx。
  max_body_bytes: 1048576 # 请求体上限，0/缺省=1MiB；签名helper限1MiB，大文件单独设计。
  max_inflight: 100 # HTTP同时处理上限，0/缺省=100，达到上限立即429。
grpc: # 整段缺失关闭公开gRPC；gateway仍可使用私有backend。
  addr: "127.0.0.1:9090" # gRPC监听地址，空值同此；非loopback必须TLS。
  network: "tcp" # 公开监听网络，缺省tcp；内部gateway固定unix，不使用此值。
  cert_file: "" # TLS证书路径，与key_file成对；仅loopback可同时留空。
  key_file: "" # TLS私钥路径，与cert_file成对，文件不入库。
  request_timeout: "3s" # unary上下文预算，0/缺省=3s，不延长客户端deadline。
  max_recv_bytes: 1048576 # 入站消息上限，0/缺省=1MiB，必须为正。
  max_send_bytes: 1048576 # 出站消息上限，0/缺省=1MiB，必须为正。
  max_concurrent_streams: 100 # 每连接并行流上限，0/缺省=100；不表示逐消息QPS。
  max_inflight: 100 # 公开gRPC跨连接unary/stream合计并发，0/缺省=100，必须为正；满时ResourceExhausted，健康/私有gateway跳过。
  reflection: false # 注册反射，缺省false；启用仍执行stream鉴权。
gateway_socket: "./run/gateway.sock" # proto HTTP桥接私有socket，留空关闭（HTTP仅保留探针）；父目录0700、socket0600，相对cwd。
rate_limit_qps: 100 # 每AppKey双协议合计本地QPS，缺省0关闭，负数非法；burst=QPS，无多副本共享保证。
auth: # HTTP签名防重放存储；缺省使用本进程有界内存，不跨重启/副本共享。
  nonce_capacity: 100000 # 全局有效nonce上限，0/缺省=100000，必须为正且不少于不同HTTP AppKey数；到期前不驱逐。
  nonce_capacity_per_app_key: 0 # 每AppKey预留份额，0/缺省=nonce_capacity/HTTP AppKey数（向下取整）；正值不得超过均分值，KeyID轮换共享，满时429。
metrics:
  enabled: false # 最小指标及GET /metrics，缺省false；开启要求HTTP，仅直连loopback来源可读，转发头无效，探针/抓取不计入业务指标。
clients: {} # 出站下游名称到配置的映射；缺省空，不建客户端/不发请求。最多64个安全名称，HTTP/gRPC共用同名依赖的并发与指标。
# 如需下游，将上面的 clients: {} 替换为以下结构，按真实目标调整；本示例不默认启用下游或业务重试。
# clients:
#   peer: # 固定下游/指标名称，1–64位安全ASCII；同一项的HTTP/gRPC应指向同一依赖。
#     app_key: "this-service" # 本服务访问下游的身份，必填；不转发入站调用方AppKey，对方需授权该身份。
#     key_id: "primary" # HTTP签名的密钥版本，HTTP启用必填；仅gRPC可留空，与对方凭据KeyID一致。
#     secret_env: "PEER_APP_SECRET" # 本服务访问该下游的HMAC变量名称；HTTP启用必填，值>=32字节；HTTP关闭可省略。
#     token_env: "PEER_APP_TOKEN" # 本服务访问该下游的Bearer变量名称；gRPC启用必填，值32–4096字节，与认证器上限一致；gRPC关闭可省略。
#     protection: # 作用于该下游的所有HTTP/gRPC调用，不是入站配额。
#       timeout: "3s" # 整体调用预算，含建连/响应读取/整个stream；0/缺省=3s，必须>0且不延长caller deadline。长期stream须明确调大。
#       max_inflight: 100 # 两协议合计在途调用上限，0/缺省=100，必须>0；满时快速失败，不建立额外等待队列。
#       circuit_breaker: false # 下游熔断开关，缺省false；true沿用30s窗口/20样本/50%失败/10s开启/半开1。上游取消/预算耗尽排除；本下游timeout到期仍是失败，分类/阈值可由runtime装配。
#     http: # 整段缺失关闭该下游HTTP；HTTP/gRPC至少启用一项。
#       service: "peer-service" # HMAC目标服务名，必填，1–64位安全ASCII；必须与对方name一致。
#       base_url: "http://127.0.0.1:8081" # 必填固定origin，无用户/路径前缀/query/fragment；明文仅loopback，跨主机必须HTTPS；不自动跟随重定向。
#       ca_file: "" # HTTPS额外CA路径，相对进程cwd；空使用系统信任，不跳过验证；HTTP时必须空。
#       max_request_bytes: 1048576 # 原始签名body上限，0/缺省=1MiB，必须在(0,1MiB]，与SignHTTP限制一致。
#       max_response_bytes: 10485760 # 解压后响应读取上限，0/缺省=10MiB，必须>0且<MaxInt64；超限不返回body。
#       max_idle_conns_per_host: 10 # 每目标保留的空闲连接，0/缺省=10，必须>0且<=max_conns_per_host。
#       max_conns_per_host: 100 # 每目标总连接数，0/缺省=100，必须>0；连接等待受整体预算与请求并发限制，不能替代HTTP/2调用并发控制。
#     grpc: # 整段缺失关闭该下游gRPC；不使用私有gateway身份通道。
#       target: "127.0.0.1:9091" # 必填静态host:port，端口1–65535；不使用注册中心或远端service config。
#       plaintext: true # 缺省false使用TLS；true仅loopback/localhost，且ca_file/server_name必须空；远端禁止明文。
#       ca_file: "" # TLS额外CA路径，相对进程cwd；空使用系统信任，保持证书验证。
#       server_name: "" # TLS验证/SNI名称，空回落target host；plaintext时必须空。
#       max_recv_bytes: 1048576 # 单条响应消息上限，0/缺省=1MiB，必须>0；unary/stream的单次选项不能放宽此上限。
#       max_send_bytes: 1048576 # 单条请求消息上限，0/缺省=1MiB，必须>0；单次选项不能放宽此上限。
# 不提供retry开关；框架不自动执行业务重试，gRPC策略重试关闭；未发送/未处理RPC仍可透明重试且共用预算。HTTP已签名请求不在不确定断连后重放。业务需重试时由runtime adapter在幂等与总预算内决定，并重新签名。
keys: # 必填认证引用列表，同AppKey多个KeyID可轮换；不能置空绕过鉴权。
  - app_key: "example-client" # 调用服务公开标识，必填，安全字符1–64位。
    key_id: "primary" # 密钥版本，必填，同AppKey内唯一，安全字符1–64位。
    secret_env: "SERVICE_APP_SECRET" # HMAC secret环境变量名称，HTTP启用必填，值>=32字节。
    token_env: "SERVICE_APP_TOKEN" # Bearer token环境变量名称，公开gRPC启用必填，值32–4096字节，与认证器输入上限一致。
log:
  level: "info" # 日志阈值debug/info/warn/error，缺省info。
  json: true # 是否JSON输出，缺省false；生产建议true。
  path: "" # 文件路径前缀，留空关闭文件输出；systemd收集控制台日志。
  console: true # 控制台输出，未配置回落true；不可与文件输出同时关闭。

