# 示例仅引用环境变量，不含明文 secret/token。真实配置复制为 env.yml，禁止入库。
name: "example-service" # HMAC 目标服务名称，必填，调用方签名使用同一值，1–64 位安全标识。
shutdown_timeout: "20s" # 全局排空预算，缺省20s，必须>0且小于systemd TimeoutStopSec=30s。
http: # 整段缺失即关闭HTTP；至少启用HTTP/gRPC之一。
  addr: "127.0.0.1:8080" # HTTP监听地址，空值同此；非loopback须同时配置cert_file/key_file。
  cert_file: "" # TLS证书路径，与key_file成对；仅loopback可同时留空。
  key_file: "" # TLS私钥路径，与cert_file成对，私钥文件不入库。
  read_header_timeout: "5s" # 读请求头上限，0/缺省=5s，必须为正。
  read_timeout: "10s" # 读取完整请求上限，0/缺省=10s，必须为正。
  write_timeout: "15s" # 响应写入上限，0/缺省=15s，须>=request_timeout。
  idle_timeout: "60s" # keep-alive空闲期限，0/缺省=60s，必须为正。
  request_timeout: "3s" # 请求处理上下文预算，0/缺省=3s，handler须遵守ctx。
  max_body_bytes: 1048576 # 请求体上限，0/缺省=1MiB；签名helper限1MiB，大文件单独设计。
  max_inflight: 100 # HTTP同时处理上限，0/缺省=100，达到上限立即429。
grpc: # 整段缺失关闭公开gRPC；gateway仍可使用私有backend。
  addr: "127.0.0.1:9090" # gRPC监听地址，空值同此；非loopback必须TLS。
  network: "tcp" # 公开监听网络，缺省tcp；内部gateway固定unix，不使用此值。
  cert_file: "" # TLS证书路径，与key_file成对；仅loopback可同时留空。
  key_file: "" # TLS私钥路径，与cert_file成对，文件不入库。
  request_timeout: "3s" # unary上下文预算，0/缺省=3s，不延长客户端deadline。
  max_recv_bytes: 1048576 # 入站消息上限，0/缺省=1MiB，必须为正。
  max_send_bytes: 1048576 # 出站消息上限，0/缺省=1MiB，必须为正。
  max_concurrent_streams: 100 # 每连接并行流上限，0/缺省=100；不表示逐消息QPS。
  reflection: false # 注册反射，缺省false；启用仍执行stream鉴权。
gateway_socket: "./run/gateway.sock" # proto HTTP桥接私有socket，留空关闭（HTTP仅保留探针）；父目录0700、socket0600，相对cwd。
rate_limit_qps: 100 # 每AppKey双协议合计本地QPS，缺省0关闭，负数非法；burst=QPS，无多副本共享保证。
keys: # 必填认证引用列表，同AppKey多个KeyID可轮换；不能置空绕过鉴权。
  - app_key: "example-client" # 调用服务公开标识，必填，安全字符1–64位。
    key_id: "primary" # 密钥版本，必填，同AppKey内唯一，安全字符1–64位。
    secret_env: "SERVICE_APP_SECRET" # HMAC secret环境变量名称，HTTP启用必填，值>=32字节。
    token_env: "SERVICE_APP_TOKEN" # Bearer token环境变量名称，公开gRPC启用必填，值>=32字节。
log:
  level: "info" # 日志阈值debug/info/warn/error，缺省info。
  json: true # 是否JSON输出，缺省false；生产建议true。
  path: "" # 文件路径前缀，留空关闭文件输出；systemd收集控制台日志。
  console: true # 控制台输出，未配置回落true；不可与文件输出同时关闭。

